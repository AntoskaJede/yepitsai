# Copy to server/.env for local dev. Never commit real values.
ANTHROPIC_API_KEY=
JWT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
FROM_EMAIL=YepIts.ai <pava@yepits.ai>
APP_URL=http://localhost:5173
CORS_ORIGINS=https://yepits.ai,http://localhost:5173

# Analytics dashboard: /stats?token=<ADMIN_TOKEN> and GET /api/stats
ADMIN_TOKEN=

# SQLite location. Railway volume is /data; macOS has no writable /data.
DB_PATH=./data/yepitsai.db
